<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.controllers.CardController" prefHeight="103.0" prefWidth="189.0" styleClass="card" spacing="5">
    <children>
        <HBox prefHeight="43.0" prefWidth="120.0" spacing="10">
            <children>
                <Label fx:id="codigoLabel" prefHeight="43.0" prefWidth="217.0" text="">
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="20.0" top="20.0" />
                    </padding>
                    <font>
                        <Font name="Segoe UI" size="13.0" />
                    </font>
                </Label>
                <Pane prefHeight="43.0" prefWidth="121.0">
                    <children>
                        <ImageView fx:id="iconImage" fitHeight="16.0" fitWidth="14.0" layoutX="4.0" layoutY="22.0">
                            <image>
                                <Image url="@../img/archivo-factura-dolar.png" />
                            </image>
                        </ImageView>
                    </children>
                </Pane>
            </children>
        </HBox>
        <Label fx:id="saldoLabel" prefHeight="28.0" prefWidth="186.0" text="">
            <padding>
                <Insets bottom="5.0" left="5.0" right="20.0" top="20.0" />
            </padding>
            <font>
                <Font name="Segoe UI Bold" size="20.0" />
            </font>
        </Label>
    </children>
</VBox>
