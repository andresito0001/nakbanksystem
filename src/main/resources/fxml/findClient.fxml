<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="anchorpane" prefHeight="600.0" prefWidth="747.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="clientsTableId" layoutX="22.0" layoutY="117.0" prefHeight="443.0" prefWidth="693.0" stylesheets="@../css/findClient.css">
        <columns>
          <TableColumn fx:id="cedulaId" prefWidth="109.0" sortable="false" text="Cedula" />
          <TableColumn fx:id="nombreId" prefWidth="135.0" sortable="false" text="Nombre" />
            <TableColumn fx:id="apellidoId" prefWidth="216.0" sortable="false" text="Apellido" />
            <TableColumn fx:id="aliasId" editable="false" prefWidth="149.0" sortable="false" text="Alias" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <ImageView fitHeight="25.0" fitWidth="26.0" layoutX="22.0" layoutY="36.0" onMouseClicked="#back">
         <image>
            <Image url="@../img/back-icon.png" />
         </image>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </ImageView>
      <Label fx:id="titleid" layoutX="48.0" layoutY="84.0" prefHeight="17.0" prefWidth="132.0" stylesheets="@../css/findClient.css" text="Buscar Clientes" />
      <TextField fx:id="clientFieldId" layoutX="455.0" layoutY="77.0" stylesheets="@../css/findClient.css" />
      <ComboBox fx:id="filterId" layoutX="187.0" layoutY="77.0" prefHeight="25.0" prefWidth="207.0" promptText="Filtro" stylesheets="@../css/findClient.css" />
      <Button fx:id="findButtonId" layoutX="632.0" layoutY="77.0" mnemonicParsing="false" onMouseClicked="#findClient" stylesheets="@../css/findClient.css" text="Buscar" />
      <Label fx:id="filterLabelId" layoutX="462.0" layoutY="55.0" />
   </children>
</AnchorPane>
